# Replace <your-key> with your actual Gemini API key
GEMINI_API_KEY="<your-key>"
GEMINI_MODEL="models/gemini-3-pro-image-preview"

# Prompt selection
PROMPT_ID="4"
# PROMPT_PATH="prompts/ask_for_shadows_PID4.md"
# SHADOW_ONLY="true"

# Concurrency
MAX_ASYNC="3"

# Sizing
API_MAX_SIDE="4096"
MAX_SIDE="4096"

# Output control
OUTPUT_WHITE_BG="false"

# Recipient submission
CLEAR_RECIPIENT_ALPHA="true"
RECIPIENT_BG_COLOR="255,255,255"
CLEAR_RECIPIENT_BG_ALPHA="true"
RECIPIENT_ALPHA_BG_THRESHOLD="220"

# Donor alignment + prep
ALIGN_DONOR_TO_RECIPIENT="true"
DONOR_BG_THRESHOLD="24"
DONOR_CROP_TO_SUBJECT="true"
DONOR_CROP_MARGIN="0.2"
DONOR_CONTRAST_BOOST="1.2"

# Shadow mask (shadow-only mode)
SHADOW_MASK_WHITE_IS_SHADOW="false"
SHADOW_MASK_STRENGTH="1.0"
SHADOW_MASK_MIN_ALPHA="8"
SHADOW_MASK_REMOVE_RECIPIENT="true"
SHADOW_MASK_REMOVE_THRESHOLD="8"
SHADOW_MASK_REMOVE_DILATE="4"
SHADOW_MASK_ALIGN="true"
SHADOW_ALIGN_MODE="feet"
SHADOW_ALIGN_WIDTH_FACTOR="1.0"
SHADOW_ALIGN_THRESHOLD="0"
SHADOW_ALIGN_PERCENTILE="90"
SHADOW_ALIGN_FOOT_PERCENTILE="90"
SHADOW_ALIGN_FOOT_BAND="12"
SHADOW_ALIGN_OFFSET_X="0"
SHADOW_ALIGN_OFFSET_Y="0"

# Backend toggle: set true for Vertex AI, false for public Gemini API.
USE_VERTEX="true"
# GOOGLE_GENAI_USE_VERTEXAI="false"

# Vertex AI (required when USE_VERTEX=true)
GOOGLE_CLOUD_PROJECT="your-gcp-project"
GOOGLE_CLOUD_LOCATION="global"
GOOGLE_APPLICATION_CREDENTIALS="vertex.json"

REPO="https://github.com/cameronstiffler/rh-shadows"
