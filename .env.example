# Replace <your-key> with your actual Gemini API key
GEMINI_API_KEY="<your-key>"
GEMINI_MODEL="models/gemini-3-pro-image-preview"

# Prompt selection
PROMPT_ID="1"
# PROMPT_PATH="prompts/mv_shd_donor_to_recipient_PID1.md"

# Concurrency
MAX_ASYNC="3"
PAD_BEFORE_SEND="true"
PAD_MAX_SIDE="4096"
PAD_MULTIPLE="8"
PAD_COLOR="255,255,255"

# Output control
OUTPUT_WHITE_BG="false"
# Recipient submission
CLEAR_RECIPIENT_ALPHA="true"
RECIPIENT_BG_COLOR="255,255,255"
CLEAR_RECIPIENT_BG_ALPHA="true"
RECIPIENT_ALPHA_BG_THRESHOLD="220"
# Donor alignment
ALIGN_DONOR_TO_RECIPIENT="true"
DONOR_BG_THRESHOLD="24"
DONOR_CROP_TO_SUBJECT="true"
DONOR_CROP_MARGIN="0.2"
DONOR_CONTRAST_BOOST="1.2"
# Shadow mask strength (shadow-only mode)
SHADOW_MASK_STRENGTH="1.0"
SHADOW_MASK_REMOVE_RECIPIENT="true"
SHADOW_MASK_REMOVE_THRESHOLD="8"
SHADOW_MASK_REMOVE_DILATE="4"
SHADOW_MASK_ALIGN="true"
SHADOW_MASK_ALIGN_MODEL="true"
SHADOW_ALIGN_WIDTH_FACTOR="1.0"
SHADOW_ALIGN_THRESHOLD="0"
SHADOW_ALIGN_PERCENTILE="90"
SHADOW_ALIGN_MODE="feet"
SHADOW_ALIGN_FOOT_PERCENTILE="90"
SHADOW_ALIGN_FOOT_BAND="12"
SHADOW_ALIGN_OFFSET_X="0"
SHADOW_ALIGN_OFFSET_Y="0"
# Shadow extraction (shadow-only mode)
SHADOW_EXTRACT_GAMMA="1.0"
SHADOW_EXTRACT_NORMALIZE="true"
SHADOW_EXTRACT_PERCENTILE="99"
SHADOW_MASK_WHITE_IS_SHADOW="false"
SHADOW_MASK_MIN_ALPHA="8"
SHADOW_MASK_CLIP_TO_RECIPIENT="true"
SHADOW_MASK_CLIP_X_MARGIN="80"
SHADOW_MASK_CLIP_Y_MARGIN="0"
SHADOW_MASK_CLIP_ABOVE_OFFSET="8"
# Shadow mask source (model, donor, or recipient)
SHADOW_MASK_SOURCE="model"
SHADOW_MASK_SIMPLE="true"
SHADOW_MASK_NORMALIZE="true"
SHADOW_MASK_NORMALIZE_PERCENTILE="98"
SHADOW_MASK_INPUT_GAMMA="1.0"
SHADOW_MASK_USE_RAW_ALPHA="true"
SHADOW_MASK_APPLY_TO_RGB="false"
SHADOW_MASK_OVERLAY_RAW_ONLY="false"
SHADOW_MASK_COMPOSITE_RECIPIENT_OVER_RAW="false"
SHADOW_MASK_FORCE_ALPHA="true"
SHADOW_MASK_OFFSET_X="0"
SHADOW_MASK_OFFSET_Y="0"
SHADOW_MASK_FLOOR_ONLY="true"
SHADOW_MASK_FLOOR_OFFSET="0"
SHADOW_MASK_CLEAR_CORNER_MARKS="false"
SHADOW_MASK_USE_CORNERS="false"
SHADOW_MASK_CORNER_THRESHOLD="16"
SHADOW_MASK_CORNER_WINDOW="24"
SHADOW_RECIPIENT_OPAQUE_THRESHOLD="220"

# Backend toggle: set true for Vertex AI, false for public Gemini API.
USE_VERTEX="true"
# GOOGLE_GENAI_USE_VERTEXAI="false"

# Vertex AI (required when USE_VERTEX=true)
GOOGLE_CLOUD_PROJECT="your-gcp-project"
GOOGLE_CLOUD_LOCATION="global"
GOOGLE_APPLICATION_CREDENTIALS="vertex.json"

REPO="https://github.com/cameronstiffler/rh-shadows"
